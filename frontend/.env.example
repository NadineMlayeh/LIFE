# Where the API lives.
# Local:      http://localhost:3000
# Production: the deployed API's URL, e.g. https://life-api.vercel.app
#
# Baked in at BUILD time, not read at runtime — Vite substitutes it into the bundle. Changing
# it in Vercel's settings therefore requires a redeploy, not just a restart.
VITE_API_URL=http://localhost:3000
