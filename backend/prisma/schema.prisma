generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PRIVATE
  SHARE_ONLY
  PUBLIC
}

enum GoalStatus {
  PENDING
  ACHIEVED
  NOT_ACHIEVED
  RESCHEDULED
}


model User {
  id            String   @id @default(uuid())
  // Email is for signing in and nothing else. It is never how anyone finds you — that is what
  // the username is for, so you can be findable without handing out your address.
  email         String   @unique
  // The public handle. Unique, and changeable: a name you chose years ago should not be a life
  // sentence. Stored as typed; matched case-insensitively via `usernameLower`.
  username      String   @unique
  usernameLower String   @unique
  passwordHash  String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  verificationTokens EmailVerificationToken[]
  passwordResets     PasswordResetToken[]
  profile         Profile?
  books           Book[]
  timelineEvents  TimelineEvent[]
  notes           Note[]
  photos          Photo[]
  visitedCountries VisitedCountry[]
  privacySettings PrivacySetting[]
  shareLinks      ShareLink[]
  sentLetters     Letter[]         @relation("SentLetters")
  receivedLetters Letter[]         @relation("ReceivedLetters")
}

// Spec C.8: deliberately minimal. A letter between two LIFE accounts — not a chat system,
// not a feed, no attachments.
model Letter {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("SentLetters", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ReceivedLetters", fields: [recipientId], references: [id], onDelete: Cascade)
  subject     String
  body        String
  /// A letter may carry an invitation: the token of one of the sender's share links, so the
  /// reader can step into their room straight from the letter. Nullable — most letters are
  /// just letters. Not a foreign key on purpose: if the sender later revokes the link the
  /// letter should survive, and the door simply stops opening.
  shareToken  String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId])
  @@index([senderId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String?
  dob         DateTime?
  birthplace  String?
  nationality String?
  languages   String?
  updatedAt   DateTime @updatedAt

}

model Book {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  icon     String?
  isCustom Boolean @default(true)
  isHidden Boolean @default(false)
  // The physical shelf holds a limited number of books. This says which ones stand on it;
  // everything else lives in the full library. Hidden is different — that means hidden
  // everywhere.
  onShelf  Boolean @default(true)

  chapters       Chapter[]
  timelineEvents TimelineEvent[]

  @@index([userId])
}

model Chapter {
  id     String @id @default(uuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title  String
  order  Int    @default(0)

  /// A chapter is written freely, as one continuous page. The owner rejected the extra
  /// `Item` level that used to sit here: book > chapter > content, nothing between.
  content String?

  @@index([bookId])
}


model TimelineEvent {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime
  description String?
  type        String?
  bookId      String?
  book        Book?       @relation(fields: [bookId], references: [id], onDelete: SetNull)
  isGoal      Boolean     @default(false)
  goalStatus  GoalStatus?
  createdAt   DateTime    @default(now())

  photos Photo[]

  @@index([userId])
  @@index([bookId])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Photo {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  storagePath  String
  originalName String
  mimeType     String
  size         Int
  caption      String?
  visibility   Visibility @default(PRIVATE)
  isFeatured   Boolean    @default(false)
  createdAt    DateTime   @default(now())

  // A photo may optionally hang off a timeline event. Books are deliberately not linkable:
  // they are for writing, and attachments were complexity the owner did not want.
  timelineEventId String?
  timelineEvent   TimelineEvent? @relation(fields: [timelineEventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([timelineEventId])
}

model VisitedCountry {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryCode String
  visitedDate DateTime?
  notes       String?
  status      String    @default("visited")

  @@index([userId])
}

model PrivacySetting {
  id         String     @id @default(uuid())
  entityType String
  entityId   String
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibility Visibility @default(PRIVATE)

  @@unique([entityType, entityId])
  @@index([userId])
}

model ShareLink {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  /// A key that never expires is a key you have to remember to take back. Links now lapse on
  /// their own; `null` means it never will, which stays possible but is no longer the default.
  expiresAt DateTime?
  revoked   Boolean  @default(false)

  @@index([userId])
}

/// A single-use token for setting a forgotten password. Separate from the email-verification
/// token because the two mean different things: one proves you own an address, the other
/// grants the power to change a credential.
/// The bytes of an uploaded photograph, when there is nowhere else to put them.
///
/// Object storage is the right home for files, and `StorageService` prefers it whenever one is
/// configured. But every provider worth using now asks for a payment card even on a free tier,
/// which is a hard stop rather than an inconvenience — so this exists as a third option that
/// needs no account at all.
///
/// Deliberately its own table rather than a column on `Photo`: listing an album must not drag
/// megabytes of image data along with the captions.
model StoredFile {
  /// The same `storagePath` held on the Photo row.
  path      String   @id
  data      Bytes
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
