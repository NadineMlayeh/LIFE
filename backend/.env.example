# ─── Database ────────────────────────────────────────────────────────────────
# Local: the Docker Postgres on 5433.
# Production: Neon's POOLED connection string (the one with "-pooler" in the host).
# The pooled one matters: serverless opens a connection per instance, and an unpooled
# Postgres runs out of them quickly.
DATABASE_URL="postgresql://life:life@127.0.0.1:5433/life_dev?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Any long random string. Generate one with:  openssl rand -base64 48
# Changing it logs everybody out, because every existing token becomes unverifiable.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# ─── Where things live ───────────────────────────────────────────────────────
PORT=3000
# The frontend's address. Used to build links inside emails, and as the CORS allow-list —
# a browser on any other origin is refused.
APP_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# ─── Email ───────────────────────────────────────────────────────────────────
# Local: Mailpit, which catches everything and delivers nothing. Read it at localhost:8025.
# Production: an SMTP provider — Resend's is smtp.resend.com, port 587, user "resend",
# password = your API key. Set SMTP_USER and SMTP_PASS and mail starts actually arriving.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="LIFE <no-reply@life.local>"

# ─── Photograph storage ──────────────────────────────────────────────────────
# Leave S3_BUCKET empty to use local disk (development).
#
# Set it in production. Serverless hosting has no persistent disk: a file written during one
# request is gone before the next, because the machine that handled it no longer exists.
# Any S3-compatible service works; Cloudflare R2 is free for 10 GB and charges nothing for
# reading the files back.
UPLOAD_DIR="uploads"
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
