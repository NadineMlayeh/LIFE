# ─── Database ────────────────────────────────────────────────────────────────
# Local: the Docker Postgres on 5433.
# Production: Neon's POOLED connection string (the one with "-pooler" in the host).
# The pooled one matters: serverless opens a connection per instance, and an unpooled
# Postgres runs out of them quickly.
DATABASE_URL="postgresql://life:life@127.0.0.1:5433/life_dev?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Any long random string. Generate one with:  openssl rand -base64 48
# Changing it logs everybody out, because every existing token becomes unverifiable.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# ─── Where things live ───────────────────────────────────────────────────────
PORT=3000
# The frontend's address. Used to build links inside emails, and as the CORS allow-list —
# a browser on any other origin is refused.
APP_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# ─── Email ───────────────────────────────────────────────────────────────────
# Plain SMTP. No provider is named anywhere in the code, so changing service is these five
# lines and nothing else.
#
# Local: Mailpit, which catches everything and delivers nothing. Read it at localhost:8025.
# Leaving SMTP_USER empty is what selects the unauthenticated local path.
#
# Production: the question to ask a provider is not "is it free" but "will it deliver to
# someone who is not me". Free tiers split into two kinds:
#
#   * Single-sender — verify one email address by clicking a link. Free, no domain, and it
#     will write to anyone. Gmail (smtp.gmail.com, an app password as SMTP_PASS) or Brevo.
#   * Domain-verified — Resend, Postmark. Refuse every recipient but the account's own until
#     you own a domain and add DNS records. Better, once a domain exists.
#
# MAIL_FROM must match the verified sender. Gmail rewrites anything else and does so silently.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="LIFE <no-reply@life.local>"

# ─── Photograph storage ──────────────────────────────────────────────────────
# Three options, in order of preference. Production MUST use one of the first two: serverless
# hosting has no persistent disk, so a file written during one request is gone before the next.
#
# 1. Object storage — set S3_BUCKET and the rest below. The right home for files. Works with
#    Cloudflare R2, Backblaze B2, S3. Note that these now ask for a payment card even on their
#    free tiers.
#
# 2. The database — set STORE_FILES_IN_DB=true and leave S3_BUCKET empty. Needs no second
#    account and no card. Not where files belong, but perfectly workable here: photographs are
#    compressed in the browser to roughly 300 KB, so a 0.5 GB free Postgres holds about 1,500.
#    Moving to object storage later is a change of these variables, nothing more.
#
# 3. Local disk — the default. Development only.
STORE_FILES_IN_DB="false"
UPLOAD_DIR="uploads"
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
